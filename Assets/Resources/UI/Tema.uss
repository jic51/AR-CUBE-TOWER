/* =========================================================================
   AR CUBE TOWER — Tema de interfaz
   =========================================================================
   Fuente única de verdad del aspecto del juego. Los mismos valores que la
   landing (docs/styles.css), para que app y web se vean como el mismo
   producto. Cambiar un color aquí lo cambia en toda la interfaz nueva.

   Convenciones:
     --color-*   color            --espacio-*  separación
     --radio-*   esquinas         --texto-*    tamaño de letra
   ========================================================================= */

:root {
    /* Fondos y superficies */
    --color-fondo:          rgb(14, 17, 36);     /* #0e1124 */
    --color-fondo-2:        rgb(21, 26, 51);     /* #151a33 */
    --color-superficie:     rgb(27, 33, 66);     /* #1b2142 */
    --color-superficie-2:   rgb(35, 42, 82);     /* #232a52 */
    --color-borde:          rgb(47, 56, 103);    /* #2f3867 */

    /* Texto */
    --color-texto:          rgb(238, 240, 250);  /* #eef0fa */
    --color-texto-suave:    rgb(185, 191, 219);  /* #b9bfdb */
    --color-texto-tenue:    rgb(143, 150, 189);  /* #8f96bd */
    --color-tinta:          rgb(26, 20, 5);      /* sobre dorado */

    /* Acentos con significado fijo en todo el juego */
    --color-oro:            rgb(255, 201, 77);   /* monedas, acción principal */
    --color-cielo:          rgb(127, 212, 255);  /* acción secundaria, snap */
    --color-gema:           rgb(236, 116, 187);  /* gemas */
    --color-vida:           rgb(255, 138, 107);  /* vidas, peligro */
    --color-exito:          rgb(143, 224, 98);   /* meta alcanzada */

    /* Superficies translúcidas: en AR la cámara SIEMPRE tiene que verse */
    --color-vidrio:         rgba(14, 17, 36, 0.72);
    --color-vidrio-borde:   rgba(255, 255, 255, 0.10);

    --radio-s: 10px;
    --radio-m: 14px;
    --radio-l: 18px;
    --radio-pildora: 999px;

    --espacio-xs: 4px;
    --espacio-s:  8px;
    --espacio-m:  12px;
    --espacio-l:  18px;
    --espacio-xl: 26px;

    --texto-s:  22px;
    --texto-m:  26px;
    --texto-l:  32px;
    --texto-xl: 44px;
}

/* =========================================================================
   CAPAS
   Cada pieza de interfaz vive en una capa a pantalla completa dentro del
   panel compartido. Las clases que vienen después en este archivo pueden
   reposicionarla, porque ganan por orden de declaración.
   ========================================================================= */

.capa-pantalla {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* =========================================================================
   NOTIFICACIONES
   Una sola franja bajo el header. Entra deslizándose desde la derecha, se
   queda y sale igual. Todas las recompensas usan este sitio, así el jugador
   siempre sabe dónde mirar.
   ========================================================================= */

.capa-notificaciones {
    position: absolute;
    top: 190px;                 /* justo debajo del header */
    right: 0;
    left: 0;
    align-items: flex-end;      /* pegadas a la derecha */
    padding-right: 24px;
    padding-left: 90px;
}

.notificacion {
    flex-direction: row;
    align-items: center;
    min-height: 92px;
    padding: 14px 20px;
    margin-bottom: 10px;

    background-color: var(--color-vidrio);
    border-width: 2px;
    border-color: var(--color-borde);
    border-radius: var(--radio-m);

    /* Estado de reposo: fuera de pantalla, a la derecha */
    translate: 420px 0;
    opacity: 0;

    transition-property: translate, opacity;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-cubic, ease-out;
}

/* El controlador añade esta clase para que entre, y la quita para que salga */
.notificacion--visible {
    translate: 0 0;
    opacity: 1;
}

.notificacion__icono {
    width: 46px;
    height: 46px;
    margin-right: 14px;
    border-radius: var(--radio-s);
}

.notificacion__texto {
    flex-grow: 1;
    font-size: var(--texto-s);
    -unity-font-style: bold;
    color: var(--color-texto);
    white-space: normal;
}

.notificacion__valor {
    margin-left: 14px;
    font-size: var(--texto-m);
    -unity-font-style: bold;
}

/* Un color por tipo de recompensa: el jugador reconoce qué ganó sin leer */
.notificacion--monedas  { border-color: var(--color-oro); }
.notificacion--monedas  .notificacion__icono { background-color: var(--color-oro); }
.notificacion--monedas  .notificacion__valor { color: var(--color-oro); }

.notificacion--gemas    { border-color: var(--color-gema); }
.notificacion--gemas    .notificacion__icono { background-color: var(--color-gema); }
.notificacion--gemas    .notificacion__valor { color: var(--color-gema); }

.notificacion--vidas    { border-color: var(--color-vida); }
.notificacion--vidas    .notificacion__icono { background-color: var(--color-vida); }
.notificacion--vidas    .notificacion__valor { color: var(--color-vida); }

.notificacion--comodin  { border-color: var(--color-cielo); }
.notificacion--comodin  .notificacion__icono { background-color: var(--color-cielo); }
.notificacion--comodin  .notificacion__valor { color: var(--color-cielo); }

.notificacion--tiempo   { border-color: var(--color-exito); }
.notificacion--tiempo   .notificacion__icono { background-color: var(--color-exito); }
.notificacion--tiempo   .notificacion__valor { color: var(--color-exito); }

.notificacion--aviso    { border-color: var(--color-borde); }
.notificacion--aviso    .notificacion__icono { background-color: var(--color-texto-tenue); }
.notificacion--aviso    .notificacion__valor { color: var(--color-texto-suave); }

/* =========================================================================
   BOTÓN "BAJAR LA PLATAFORMA"
   Gratis, limitado solo por su enfriamiento. Abajo a la derecha, donde llega
   el pulgar sin tapar la torre ni el próximo cubo (que va abajo a la izquierda).
   ========================================================================= */

.capa-bajar {
    align-items: flex-end;
    justify-content: flex-end;
    padding-right: 42px;
    padding-bottom: 150px;
}

.bajar__contenedor {
    width: 132px;
    height: 132px;
    align-items: center;
    justify-content: center;
}

.bajar__anillo {
    position: absolute;
    width: 132px;
    height: 132px;
}

.bajar__boton {
    width: 104px;
    height: 104px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;

    background-color: var(--color-vidrio);
    border-width: 2px;
    border-color: var(--color-vidrio-borde);
    border-radius: var(--radio-pildora);

    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

/* Enfriando: apagado y sin invitar a pulsar */
.bajar__boton:disabled {
    opacity: 0.45;
}

/* Listo: verde y con borde grueso. El cian se confundía con el resto de la
   interfaz y el jugador no se daba cuenta de que ya podía pulsarlo. */
.bajar__boton--listo {
    background-color: rgba(143, 224, 98, 0.22);
    border-width: 3px;
    border-color: var(--color-exito);
}

.bajar__boton--listo .bajar__flecha {
    border-right-color: var(--color-exito);
    border-bottom-color: var(--color-exito);
}

.bajar__boton:active {
    scale: 0.92;
}

/* Flecha hacia abajo, sin imágenes: un cuadrado girado 45° al que se le ven
   dos lados hace una punta de flecha limpia a cualquier resolución */
.bajar__flecha {
    width: 34px;
    height: 34px;
    margin-bottom: 10px;
    rotate: 45deg;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-right-color: var(--color-texto);
    border-bottom-color: var(--color-texto);
}

/* =========================================================================
   HUD DE PARTIDA
   Todo en vidrio translúcido: en AR la cámara tiene que verse siempre. El
   HUD viejo tapaba la mesa del jugador con paneles azules opacos.
   ========================================================================= */

.capa-hud {
    /* la capa entera no captura toques; solo lo hacen sus botones */
    padding: 0;
}

.hud__barra {
    position: absolute;
    top: 90px;
    left: 24px;
    right: 24px;
    flex-direction: row;
    align-items: center;
    padding: 18px 22px;
    background-color: var(--color-vidrio);
    border-width: 1px;
    border-color: var(--color-vidrio-borde);
    border-radius: var(--radio-l);
}

.hud__pausa {
    width: 76px;
    height: 76px;
    margin: 0 18px 0 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    border-radius: var(--radio-m);
}

/* Dos barras: el icono de pausa, sin necesidad de imagen */
.hud__pausa-icono {
    width: 22px;
    height: 30px;
    border-left-width: 7px;
    border-right-width: 7px;
    border-left-color: var(--color-texto);
    border-right-color: var(--color-texto);
}

.hud__centro { flex-grow: 1; }

.hud__fila {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.hud__cubos {
    flex-grow: 1;
    font-size: var(--texto-s);
    color: var(--color-texto);
    -unity-font-style: bold;
}

.hud__tiempo {
    font-size: var(--texto-l);
    -unity-font-style: bold;
    color: var(--color-oro);
}

.hud__tiempo--urgente { color: var(--color-vida); }

.hud__pista {
    height: 14px;
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: var(--radio-pildora);
    overflow: hidden;
}

.hud__progreso {
    height: 14px;
    width: 0;
    background-color: var(--color-cielo);
    border-radius: var(--radio-pildora);
    transition-property: width;
    transition-duration: 0.3s;
}

/* Meta alcanzada: el color dice lo que el texto tendría que explicar */
.hud__progreso--meta { background-color: var(--color-exito); }

/* ── Recursos ─────────────────────────────────────────────────────────── */

.hud__recursos {
    position: absolute;
    top: 268px;
    right: 24px;
    flex-direction: row;
}

/* Aviso de partida dentro de la cabecera: combos, meta, cubo anclado. Antes
   era texto suelto en medio de la pantalla, encima de la torre. */
.hud__aviso {
    margin-top: 8px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── Riel de comodines ───────────────────────────────────────────────────
   Antes el inventario solo se veía abriendo la tienda. Aquí, justo debajo de
   los recursos, se ve subir el número al comprar y durante la partida se sabe
   con qué se cuenta sin salir del juego. */

.hud__comodines {
    position: absolute;
    top: 368px;
    right: 24px;
    flex-direction: row;
}

.comodin {
    width: 62px;
    height: 62px;
    margin: 0 0 0 10px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-vidrio);
    border-width: 1px;
    border-color: var(--color-vidrio-borde);
    border-radius: var(--radio-m);
    transition: border-color 0.15s ease-out, scale 0.12s ease-out;
}

.comodin:active { scale: 0.92 0.92; }

/* Armado y esperando: sin esto el jugador pulsaba otra vez creyendo que no
   había pasado nada, y la segunda vez solo le decían "already armed". */
.comodin--activo {
    border-width: 2px;
    border-color: var(--color-cielo);
    background-color: rgba(127, 212, 255, 0.22);
}

/* Sin ninguno queda visible pero apagado: así el jugador sabe que el comodín
   existe y puede comprarlo, en vez de descubrirlo solo en la tienda. */
.comodin--vacio { opacity: 0.38; }

.comodin__cuenta {
    position: absolute;
    right: -6px;
    bottom: -6px;
    min-width: 28px;
    padding: 1px 7px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-tinta);
    background-color: var(--color-cielo);
    border-radius: var(--radio-pildora);
}

.comodin--vacio .comodin__cuenta {
    color: var(--color-texto-suave);
    background-color: var(--color-superficie-2);
}

.chip {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    margin-left: 10px;
    background-color: var(--color-vidrio);
    border-width: 1px;
    border-color: var(--color-vidrio-borde);
    border-radius: var(--radio-pildora);
}

/* El punto de color se sustituyó por la figura dibujada (Iconos.cs): el color
   solo no bastaba para saber si un chip era monedas, gemas o vidas. */
.chip__icono { margin-right: 9px; }

.chip__valor {
    font-size: var(--texto-s);
    -unity-font-style: bold;
    color: var(--color-texto);
}


/* ── Próximo cubo ─────────────────────────────────────────────────────── */

.hud__proximo {
    position: absolute;
    left: 24px;
    bottom: 60px;
    flex-direction: row;
    align-items: center;
    max-width: 620px;
    padding: 16px 22px 16px 16px;
    background-color: var(--color-vidrio);
    border-width: 1px;
    border-color: var(--color-vidrio-borde);
    border-radius: var(--radio-l);
}

/* El cubo se DIBUJA (tres caras isométricas), no es un color de fondo: un
   cuadrado plano no se leía como un cubo con los tipos claros */
.hud__proximo-color {
    width: 86px;
    height: 86px;
    margin-right: 16px;
}

.hud__proximo-etiqueta {
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--color-texto-suave);
}

.hud__proximo-nombre {
    font-size: var(--texto-s);
    -unity-font-style: bold;
    color: var(--color-texto);
}

.hud__proximo-detalle {
    font-size: 19px;
    color: var(--color-texto-suave);
    white-space: normal;
    max-width: 480px;
}


/* =========================================================================
   TIENDA
   El saldo siempre visible y los botones que dicen por qué no se puede
   comprar: antes solo se apagaban y el jugador no sabía qué le faltaba.
   ========================================================================= */

.capa-tienda { align-items: center; justify-content: center; }

.tienda {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: var(--color-fondo);
    padding: 90px 40px 40px 40px;
}

.tienda__cabecera { flex-direction: row; align-items: center; margin-bottom: 24px; }

.tienda__cerrar {
    width: 78px; height: 78px; margin: 0 20px 0 0; padding: 0;
    font-size: var(--texto-m); color: var(--color-texto);
    background-color: var(--color-superficie);
    border-width: 1px; border-color: var(--color-borde);
    border-radius: var(--radio-m);
}

.tienda__titulo {
    flex-grow: 1;
    font-size: var(--texto-l);
    -unity-font-style: bold;
    color: var(--color-texto);
}

.tienda__saldos { flex-direction: row; }

.tienda__tabs {
    flex-direction: row;
    padding: 8px;
    margin-bottom: 20px;
    background-color: var(--color-fondo-2);
    border-radius: var(--radio-m);
}

.tienda__tab {
    flex-grow: 1;
    height: 72px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--radio-s);
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
}

.tienda__tab--activa {
    background-color: var(--color-superficie-2);
    color: var(--color-texto);
    -unity-font-style: bold;
}

.tienda__scroll { flex-grow: 1; }

.tienda__seccion {
    margin: 22px 0 10px 4px;
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--color-texto-suave);
}

.tienda__aviso {
    margin: 0 0 12px 4px;
    font-size: 20px;
    color: var(--color-texto-suave);
}

/* ── Fila de producto ─────────────────────────────────────────────────── */

.fila {
    flex-direction: row;
    align-items: center;
    padding: 20px;
    margin-bottom: 14px;
    background-color: var(--color-superficie);
    border-width: 1px;
    border-color: var(--color-borde);
    border-radius: var(--radio-l);
}

.fila--apagada { opacity: 0.55; }

/* El cuadro de color se queda como fondo del icono dibujado: da una base
   uniforme para figuras de siluetas muy distintas (corazón, reloj, pesa). */
.fila__icono {
    width: 74px; height: 74px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-superficie-2);
    border-radius: var(--radio-m);
}

.fila__precio-linea {
    flex-direction: row;
    align-items: center;
}


.fila__textos { flex-grow: 1; }
.fila__linea  { flex-direction: row; align-items: center; }

.fila__nombre {
    font-size: var(--texto-s);
    -unity-font-style: bold;
    color: var(--color-texto);
}

.fila__inventario {
    margin-left: 14px;
    padding: 4px 14px;
    font-size: 18px;
    color: var(--color-texto-suave);
    background-color: var(--color-superficie-2);
    border-radius: var(--radio-pildora);
}

.fila__detalle {
    margin-top: 4px;
    font-size: 19px;
    color: var(--color-texto-suave);
    white-space: normal;
}

.fila__boton {
    min-width: 132px;
    margin: 0 0 0 16px;
    padding: 12px 18px;
    align-items: center;
    background-color: var(--color-oro);
    border-width: 0;
    border-radius: var(--radio-m);
}

.fila__boton:disabled {
    background-color: var(--color-superficie-2);
    border-width: 1px;
    border-color: var(--color-borde);
    opacity: 1;                  /* el motivo tiene que leerse bien */
}

.fila__precio {
    margin-left: 8px;
    font-size: var(--texto-s);
    -unity-font-style: bold;
    color: var(--color-tinta);
}

.fila__boton:disabled .fila__precio { color: var(--color-texto-suave); }

.fila__motivo {
    margin-top: 2px;
    font-size: 17px;
    color: var(--color-texto-suave);
}
